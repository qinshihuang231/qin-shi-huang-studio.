
import os
from telegram import Update, ReplyKeyboardMarkup
from telegram.ext import (
    ApplicationBuilder,
    CommandHandler,
    MessageHandler,
    ContextTypes,
    filters,
)

BOT_TOKEN = os.getenv("BOT_TOKEN")

keyboard = ReplyKeyboardMarkup(
    [
        ["Our Services", "Place an Order"],
        ["Contact Us", "Help"],
    ],
    resize_keyboard=True,
)

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "Welcome to QIN SHI HUANG STUDIO!\n\n"
        "Your online studio for lawful design and creative services.\n\n"
        "Choose an option below to get started.",
        reply_markup=keyboard,
    )

async def services(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "OUR SERVICES\n\n"
        "• CV and resume design\n"
        "• Business forms and templates\n"
        "• Graphic and document design\n"
        "• Authorized printing services\n"
        "• Fictional novelty and prop designs\n\n"
        "We do not create counterfeit IDs, passports, "
        "or documents intended to deceive."
    )

async def order(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "To request a service, please send:\n\n"
        "1. Your name\n"
        "2. The service you need\n"
        "3. A short description of your requirements\n"
        "4. Your preferred delivery date\n\n"
        "Our team will review your request and reply."
    )

async def contact(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "Thank you for contacting QIN SHI HUANG STUDIO.\n"
        "Please describe your enquiry here and our team "
        "will get back to you."
    )

async def help_command(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "Use /start to see the main menu.\n"
        "Use /services to view our services.\n"
        "Use /order to request a service.\n"
        "Use /contact to send an enquiry."
    )

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    choice = update.message.text

    if choice == "Our Services":
        await services(update, context)
    elif choice == "Place an Order":
        await order(update, context)
    elif choice == "Contact Us":
        await contact(update, context)
    elif choice == "Help":
        await help_command(update, context)
    else:
        await update.message.reply_text(
            "Thank you for your message. "
            "Please describe the lawful design service you need. "
            "Use the menu below for assistance.",
            reply_markup=keyboard,
        )

def main():
    if not BOT_TOKEN:
        raise RuntimeError("BOT_TOKEN environment variable is missing.")

    app = ApplicationBuilder().token(BOT_TOKEN).build()

    app.add_handler(CommandHandler("start", start))
    app.add_handler(CommandHandler("services", services))
    app.add_handler(CommandHandler("order", order))
    app.add_handler(CommandHandler("contact", contact))
    app.add_handler(CommandHandler("help", help_command))
    app.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))

    print("QIN SHI HUANG STUDIO bot is running.")
    app.run_polling()

if __name__ == "__main__":
    main()
